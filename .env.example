# ---------------------------------------------------------------------------
# Muhaqqiq configuration
# Copy this file to `.env` and fill in the values you actually need.
#   cp .env.example .env
#
# Nothing here is required to run the project: with no keys at all Muhaqqiq
# starts in OFFLINE mode and runs the full agent graph against a bundled
# local corpus. Add keys to run it against real models and the live web.
# ---------------------------------------------------------------------------

# --- Model provider --------------------------------------------------------
# "offline"    -> deterministic local provider, no network, no keys (default)
# "openrouter" -> hosted models through https://openrouter.ai
MUHAQQIQ_LLM_PROVIDER=offline
OPENROUTER_API_KEY=your-openrouter-key-here
MUHAQQIQ_MODEL=anthropic/claude-sonnet-4.5
MUHAQQIQ_FAST_MODEL=openai/gpt-4o-mini
MUHAQQIQ_TEMPERATURE=0.2

# --- Search provider -------------------------------------------------------
# "offline" -> bundled corpus in data/corpus (default)
# "tavily"  -> live web search
MUHAQQIQ_SEARCH_PROVIDER=offline
TAVILY_API_KEY=your-tavily-key-here

# --- Agent behaviour -------------------------------------------------------
MUHAQQIQ_MAX_SUBQUESTIONS=5
MUHAQQIQ_MAX_SOURCES_PER_SUBQUESTION=4
MUHAQQIQ_MAX_RESEARCH_ROUNDS=2
MUHAQQIQ_MIN_CITATION_COVERAGE=0.8
MUHAQQIQ_RESEARCHER_CONCURRENCY=4

# --- MCP tool server -------------------------------------------------------
MUHAQQIQ_MCP_HOST=127.0.0.1
MUHAQQIQ_MCP_PORT=8765
MUHAQQIQ_MCP_URL=http://127.0.0.1:8765/mcp

# --- Storage / output ------------------------------------------------------
MUHAQQIQ_DB_PATH=.muhaqqiq/runs.db
MUHAQQIQ_OUTPUT_DIR=out

# --- Observability (optional) ----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=muhaqqiq
